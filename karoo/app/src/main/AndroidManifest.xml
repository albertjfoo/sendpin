<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      API 27 permission model. BLUETOOTH_SCAN/CONNECT are the API 31+ successors
      and are declared with maxSdkVersion guards on the old pair so this still
      builds against compileSdk 35 without nagging.

      ACCESS_FINE_LOCATION is the one that bites: on Android 8.1 a BLE scan
      silently returns NO results without it, and it is a runtime permission
      with no UI in this app to request it. Grant it by hand after install:

        adb shell pm grant app.sendpin android.permission.ACCESS_FINE_LOCATION
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/extension_name">

        <!--
          Turns the Karoo's long-press → Update into a working button, so an
          update no longer means the USB + WebUSB install all over again.

          The head unit fetches this JSON and compares latestVersionCode against
          what is installed. Key name from karoo-ext ConstantsKt:
            MANIFEST_URL_META = io.hammerhead.karooext.MANIFEST_URL
          Shape is karoo-ext's KarooAppManifest (label, packageName,
          latestApkUrl, latestVersion, latestVersionCode, + optional fields).

          The fetch is anonymous, so the repo has to be public or this 404s and
          the update silently never appears. docs/manifest.json is generated by
          the writeKarooManifest Gradle task — do not hand-edit it.
        -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://albertjfoo.github.io/sendpin/manifest.json" />

        <!--
          Gives the extension a face. Without a launcher activity it is entirely
          invisible on the head unit: bound at boot, running, with no way to see
          its state or stop it. This is what makes it appear in the Karoo's app
          list alongside sideloaded apps like WaypointsKaroo.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/extension_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Bound by the Karoo system (io.hammerhead.appstore) via this action.
          Action name and meta-data key are from karoo-ext Constants.kt:
            KAROO_EXTENSION_INTENT_FILTER = io.hammerhead.karooext.KAROO_EXTENSION
            EXTENSION_INFO_META_KEY       = io.hammerhead.karooext.EXTENSION_INFO
        -->
        <service
            android:name=".SendPinExtension"
            android:exported="true">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>
</manifest>
