<!--
  A map pin with a share arrow: send this place.

  Colours are Hammerhead's own, read out of io.hammerhead.rideapp's resources
  rather than eyeballed — colorAccent resolves to climb_blue_500 (#2386D9),
  with the ramp running to climb_blue_700 (#00294B).

  Deliberately not their hammerhead-shark mark: that is a trademark, and this
  app is meant to be distributable.

  108x108 is the adaptive-icon viewport. Launchers may mask anything outside
  the centre 72x72, so the whole drawing is scaled and centred to sit inside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:translateX="1.8"
        android:translateY="6.3">

        <!-- Pin outline. Open on the lower right, so the arrow reads as sitting
             in front of it rather than colliding with it. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M46,88 C46,88 22,62 22,42 A24,24 0 1 1 70,42 C70,48 66,56 62,62" />

        <!-- The pin's eye. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:fillColor="#00000000"
            android:pathData="M46,27 m-13,0 a13,13 0 1 0 26,0 a13,13 0 1 0 -26,0" />

        <!-- Share arrow: curved tail sweeping up into a head. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M80,54 L94,68 L80,82 L80,74 C70,74 62,79 57,86 C58,70 68,62 80,62 Z" />
    </group>
</vector>
