    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Scaled to 80% so the glyph appears at iOS-like proportions within the yellow
         background, both in the Karoo Extensions list and in the app header. -->
    <group
        android:scaleX="0.80"
        android:scaleY="0.80"
        android:pivotX="512"
        android:pivotY="512">

