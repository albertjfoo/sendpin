<!--
  Pin with a plus: add this place. Matches the Figma logo.

  Black on Hammerhead's #FFE900, which is their own yellow — it appears in
  io.hammerhead.rideapp's resources, so the icon sits naturally next to their
  apps without borrowing their hammerhead-shark mark.

  108x108 is the adaptive-icon viewport. Launchers may mask anything outside
  the centre 72x72, so the drawing is scaled and centred to sit inside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:translateX="4.6"
        android:translateY="8.0">

        <!-- Pin outline, left open on the lower right so the plus sits in a gap
             rather than colliding with the stroke. -->
        <path
            android:strokeColor="#141414"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M50,90 C50,90 24,64 24,42 A26,26 0 1 1 76,42" />

        <!-- The pin's eye. -->
        <path
            android:strokeColor="#141414"
            android:strokeWidth="7"
            android:fillColor="#00000000"
            android:pathData="M50,40 m-14,0 a14,14 0 1 0 28,0 a14,14 0 1 0 -28,0" />

        <!-- Plus. -->
        <path
            android:strokeColor="#141414"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M66,74 L92,74 M79,61 L79,87" />
    </group>
</vector>
